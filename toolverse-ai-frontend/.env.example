# Backend API base (no trailing slash). Example: http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public site URL used for SEO canonical + OG tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Advertising (Google AdSense) ----
# Master switch. Until these are set, ad slots render nothing in production.
NEXT_PUBLIC_ADS_ENABLED=true
# Your AdSense publisher ID, e.g. ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT=
# Ad-unit IDs (numbers from AdSense → Ads → Ad units). Leave empty to hide that slot.
NEXT_PUBLIC_AD_SLOT_HOMEPAGE_TOP=
NEXT_PUBLIC_AD_SLOT_HOMEPAGE_BOTTOM=
NEXT_PUBLIC_AD_SLOT_TOOLS_BOTTOM=
NEXT_PUBLIC_AD_SLOT_TOOLPAGE=
NEXT_PUBLIC_AD_SLOT_BLOG_TOP=
NEXT_PUBLIC_AD_SLOT_ARTICLE_BOTTOM=
