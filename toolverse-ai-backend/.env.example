# ---- Core ----
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
DATABASE_PATH=./data/toolverse.sqlite
# Set to postgres connection string to use Postgres in production (requires DATABASE_PROVIDER=postgres + migration)
# DATABASE_URL=postgresql://user:pass@localhost:5432/toolverse

# ---- Auth / Security ----
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
SIGNED_URL_SECRET=change-me-signed-url-secret-min-32-chars
SIGNED_URL_TTL_SECONDS=3600
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000

# ---- Storage ----
# local | s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./storage
# S3 / R2 / MinIO (only if STORAGE_PROVIDER=s3)
# S3_BUCKET=toolverse
# S3_REGION=auto
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=

# ---- Limits ----
MAX_UPLOAD_MB=100
MAX_VIDEO_MB=500
JOB_RETENTION_DAYS=7
FILE_TTL_HOURS=24
CLEANUP_CRON=*/30 * * * *

# ---- AI Providers ----
# openai | anthropic | google — can be switched without code changes
AI_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
GOOGLE_GENERATIVE_AI_KEY=
GOOGLE_GENERATIVE_AI_MODEL=gemini-1.5-flash

# ---- Converters ----
# Optional: absolute path to LibreOffice soffice binary for pixel-perfect DOCX<->PDF. If unset, text-preserving fallback is used.
# LIBREOFFICE_PATH=
# Optional: path to poppler pdftoppm for PDF rasterization (PDF->JPG). If unset and not on PATH, PDF->JPG returns actionable error.
# Example (vendored): POPPLER_BIN_DIR=./vendor/poppler/poppler-26.09.0/Library/bin
# POPPLER_BIN_DIR=
# Background removal model: medium (default quality) | small (~40MB, fits 512MB hosts)
# BG_MODEL=medium
FFMPEG_PATH=
FFPROBE_PATH=

# ---- Admin bootstrap ----
ADMIN_EMAIL=admin@toolverse.ai
ADMIN_PASSWORD=Admin123!ChangeMe
